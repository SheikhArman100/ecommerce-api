generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "mysql"
  
}

enum UserRole {
  user
  admin
}

enum DiskType {
  LOCAL
  AWS
  SHARED
}

enum OrderStatus {
  Pending
  Shipped
  Delivered
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  phoneNumber String
  password    String
  isVerified  Boolean  @default(false)
  role        UserRole @default(user)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  //relations
  detail            UserDetail?
  refreshTokens     RefreshToken[]
  createdProducts   Product[]      @relation("ProductCreator")
  updatedProducts   Product[]      @relation("ProductUpdater")
  createdCategories Category[]     @relation("CategoryCreator")
  updatedCategories Category[]     @relation("CategoryUpdater")
  createdFlavors    Flavor[]       @relation("FlavorCreator")
  updatedFlavors    Flavor[]       @relation("FlavorUpdater")
  createdSizes      Size[]         @relation("SizeCreator")
  updatedSizes      Size[]         @relation("SizeUpdater")

  reviews   Review[]
  wishlists WishList[]
  cart      Cart?
  orders    Order[]

  //indexing
  @@index([email])
  @@index([phoneNumber])
  //rename database table name
  @@map("users")
}

model UserDetail {
  id      Int    @id @default(autoincrement())
  image   Image?
  profileImage String?
  address String
  city    String
  road    String
  userId  Int    @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("userDetails")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @db.Text
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  //indexing
  @@index([userId])
  //rename database table name
  @@map("refreshTokens")
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  slug        String   @unique
  description String   @db.Text
  createdBy   Int
  updatedBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  //relations
  categoryId Int?
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  flavors    ProductFlavor[]
  creator    User            @relation("ProductCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  updater    User?           @relation("ProductUpdater", fields: [updatedBy], references: [id], onDelete: Cascade)
  reviews    Review[]
  wishlists  WishList[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("products")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdBy Int
  updatedBy Int
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  //relations
  creator   User      @relation("CategoryCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  updater   User?     @relation("CategoryUpdater", fields: [updatedBy], references: [id], onDelete: Cascade)
  products  Product[]

  @@map("categories")
}

model Flavor {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  color     String
  createdBy Int
  updatedBy Int
  createdAt DateTime        @default(now())
  updatedAt DateTime?       @updatedAt
  //relations
  creator   User            @relation("FlavorCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  updater   User?           @relation("FlavorUpdater", fields: [updatedBy], references: [id], onDelete: Cascade)
  products  ProductFlavor[]

  @@map("flavors")
}

model Size {
  id             Int                 @id @default(autoincrement())
  name           String              @unique
  createdBy      Int
  updatedBy      Int
  createdAt      DateTime            @default(now())
  updatedAt      DateTime?           @updatedAt
  //relations
  creator        User                @relation("SizeCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  updater        User?               @relation("SizeUpdater", fields: [updatedBy], references: [id], onDelete: Cascade)
  productFlavors ProductFlavorSize[]

  @@map("sizes")
}

model Image {
  id           Int      @id @default(autoincrement())
  diskType     DiskType
  path         String
  originalName String
  modifiedName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  //relations
  productId    Int?
  flavorId     Int?
  userDetailId Int? @unique

  productFlavor ProductFlavor? @relation(fields: [productId, flavorId], references: [productId, flavorId], onDelete: Cascade)
  userDetail    UserDetail?    @relation(fields: [userDetailId], references: [id], onDelete: Cascade)

  @@unique([id, productId, flavorId])
  @@map("images")
}

model ProductFlavor {
  productId Int
  flavorId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //relations
  product Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  flavor  Flavor              @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  images  Image[]
  sizes   ProductFlavorSize[]

  @@id([productId, flavorId])
  @@map("productFlavors")
}

model ProductFlavorSize {
  productId Int
  flavorId  Int
  sizeId    Int
  stock     Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  productFlavor ProductFlavor @relation(fields: [productId, flavorId], references: [productId, flavorId], onDelete: Cascade)
  size          Size          @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@id([productId, flavorId, sizeId])
  @@index([productId, flavorId])
  @@map("product_flavor_sizes")
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      @default(5)
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int
  productId Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("reviews")
}

model WishList {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlists")
}

model Cart {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  flavorId  Int
  sizeId    Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //relations
  cart              Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productFlavorSize ProductFlavorSize @relation(fields: [productId, flavorId, sizeId], references: [productId, flavorId, sizeId], onDelete: Cascade)

  @@unique([cartId, productId, flavorId, sizeId])
  @@map("cart_items")
}

model Order {
  id          Int         @id @default(autoincrement())
  status      OrderStatus @default(Pending)
  totalAmount Float // Total cost of the order
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userId      Int

  //relations
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  flavorId  Int
  sizeId    Int
  quantity  Int      @default(1)
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //relations
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productFlavorSize ProductFlavorSize @relation(fields: [productId, flavorId, sizeId], references: [productId, flavorId, sizeId], onDelete: Cascade)

  @@map("order_items")
}
