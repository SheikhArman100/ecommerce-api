generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  user
  admin
}

enum DiskType {
  LOCAL
  AWS
  SHARED
}

enum OrderStatus {
  Pending
  Shipped
  Delivered
  Cancelled
}

enum FileType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  phoneNumber String
  password    String
  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  role        UserRole @default(user)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   Int?
  updatedBy   Int?

  // One-to-One Relations
  detail UserDetail?
  cart   Cart?

  // Many-to-One Relations
  creator User? @relation("UserCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  updater User? @relation("UserUpdater", fields: [updatedBy], references: [id], onDelete: Cascade)

  // One-to-Many Relations
  refreshTokens     RefreshToken[]
  createdProducts   Product[]      @relation("ProductCreator")
  updatedProducts   Product[]      @relation("ProductUpdater")
  createdCategories Category[]     @relation("CategoryCreator")
  updatedCategories Category[]     @relation("CategoryUpdater")
  createdFlavors    Flavor[]       @relation("FlavorCreator")
  updatedFlavors    Flavor[]       @relation("FlavorUpdater")
  createdSizes      Size[]         @relation("SizeCreator")
  updatedSizes      Size[]         @relation("SizeUpdater")
  createdUsers      User[]         @relation("UserCreator")
  updatedUsers      User[]         @relation("UserUpdater")
  reviews           Review[]
  wishlists         WishList[]
  orders            Order[]

  // Indexes
  @@index([email])
  @@index([phoneNumber])
  @@map("users")
}

model UserDetail {
  id           Int     @id @default(autoincrement())
  profileImage String?
  address      String
  city         String
  road         String
  userId       Int     @unique

  // One-to-One Relations
  image File?

  // Many-to-One Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One-to-Many Relations
  // (none)

  @@map("userDetails")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @db.Text
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  ipAddress String   @default("0.0.0.0")

  // One-to-One Relations
  // (none)

  // Many-to-One Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One-to-Many Relations
  // (none)

  // Indexes
  @@index([userId])
  @@map("refreshTokens")
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  slug        String   @unique
  description String   @db.Text
  isActive    Boolean  @default(true)
  createdBy   Int
  updatedBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  //relations
  categoryId Int?
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  flavors    ProductFlavor[]
  creator    User            @relation("ProductCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  updater    User?           @relation("ProductUpdater", fields: [updatedBy], references: [id], onDelete: Cascade)
  reviews    Review[]
  wishlists  WishList[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  // Indexes
  @@index([isActive])
  @@map("products")
}

model Category {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  slug         String? @unique // SEO-friendly URL
  description  String? // Category description
  image        File? // Category icon/image URL
  isActive     Boolean @default(true) // Enable/disable categories
  displayOrder Int     @default(0) // Sort order in navigation

  createdBy Int
  updatedBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  // Relations
  creator  User      @relation("CategoryCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  updater  User?     @relation("CategoryUpdater", fields: [updatedBy], references: [id], onDelete: Cascade)
  products Product[]

  // Indexes for performance
  @@index([isActive])
  @@index([displayOrder])
  @@map("categories")
}

model Flavor {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  color       String
  description String?
  isActive    Boolean         @default(true)
  createdBy   Int
  updatedBy   Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime?       @updatedAt
  //relations
  creator     User            @relation("FlavorCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  updater     User?           @relation("FlavorUpdater", fields: [updatedBy], references: [id], onDelete: Cascade)
  products    ProductFlavor[]

  @@index([isActive])
  @@map("flavors")
}

model Size {
  id             Int                 @id @default(autoincrement())
  name           String              @unique
  description    String?
  isActive       Boolean             @default(true)
  createdBy      Int
  updatedBy      Int
  createdAt      DateTime            @default(now())
  updatedAt      DateTime?           @updatedAt
  //relations
  creator        User                @relation("SizeCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  updater        User?               @relation("SizeUpdater", fields: [updatedBy], references: [id], onDelete: Cascade)
  productFlavors ProductFlavorSize[]

  @@index([isActive])
  @@map("sizes")
}

model File {
  id           Int      @id @default(autoincrement())
  type         FileType @default(IMAGE)
  diskType     DiskType
  path         String
  originalName String
  modifiedName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  //relations
  productId    Int?
  flavorId     Int?
  userDetailId Int? @unique
  categoryId   Int? @unique
  reviewId     Int?

  productFlavor ProductFlavor? @relation(fields: [productId, flavorId], references: [productId, flavorId], onDelete: Cascade)
  userDetail    UserDetail?    @relation(fields: [userDetailId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  review        Review?        @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([id, productId, flavorId])
  @@index([reviewId])
  @@map("files")
}

model ProductFlavor {
  productId Int
  flavorId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //relations
  product Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  flavor  Flavor              @relation(fields: [flavorId], references: [id], onDelete: Restrict)
  images  File[]
  sizes   ProductFlavorSize[]

  @@id([productId, flavorId])
  @@map("productFlavors")
}

model ProductFlavorSize {
  id             Int      @id @default(autoincrement()) // Auto-increment primary key
  productId      Int
  flavorId       Int
  sizeId         Int? // Optional for quantity products
  stock          Int
  price          Float
  soldByQuantity Boolean  @default(false) // Flag for quantity-based products
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  productFlavor ProductFlavor @relation(fields: [productId, flavorId], references: [productId, flavorId], onDelete: Restrict)
  size          Size?         @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  cartItems     CartItem[]
  orderItems    OrderItem[]

  // Unique constraint for size-based products (allows null sizeId for quantity)
  @@unique([productId, flavorId, sizeId])
  @@index([productId, flavorId])
  @@map("product_flavor_sizes")
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      @default(5)
  comment   String
  isHidden  Boolean  @default(false) // Admin can hide inappropriate reviews
  adminNote String?  // Internal note for hide reason
  ipAddress String   // Client IP at creation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int
  productId Int
  orderId   Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  images  File[] // Review images

  @@unique([productId, orderId])
  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([isHidden])
  @@map("reviews")
}

model WishList {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlists")
}

model Cart {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  flavorId  Int
  sizeId    Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //relations
  cart              Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productFlavorSize ProductFlavorSize @relation(fields: [productId, flavorId, sizeId], references: [productId, flavorId, sizeId], onDelete: Restrict)

  @@map("cart_items")
}

model Order {
  id          Int         @id @default(autoincrement())
  status      OrderStatus @default(Pending)
  totalAmount Float // Total cost of the order
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userId      Int

  //relations
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   OrderItem[]
  reviews Review[] // Reviews for this order

  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  flavorId  Int
  sizeId    Int
  quantity  Int      @default(1)
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //relations
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productFlavorSize ProductFlavorSize @relation(fields: [productId, flavorId, sizeId], references: [productId, flavorId, sizeId], onDelete: Restrict)

  @@map("order_items")
}
